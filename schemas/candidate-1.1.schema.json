{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nathanmcnulty/azd-santa/schemas/candidate-1.1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidateId",
    "state",
    "evaluationTime",
    "reviewExpiresAt",
    "evidenceDigest",
    "observation",
    "proposedRule",
    "counterfactual",
    "riskFlags",
    "generator",
    "outputDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1"
    },
    "candidateId": {
      "type": "string",
      "pattern": "^candidate-[0-9a-f]{64}$"
    },
    "state": {
      "const": "draft"
    },
    "evaluationTime": {
      "type": "string",
      "format": "date-time"
    },
    "reviewExpiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "evidenceDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "firstSeen",
        "lastSeen",
        "eventCount",
        "deviceCount"
      ],
      "properties": {
        "firstSeen": {
          "type": "string",
          "format": "date-time"
        },
        "lastSeen": {
          "type": "string",
          "format": "date-time"
        },
        "eventCount": {
          "type": "integer",
          "minimum": 1
        },
        "deviceCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "proposedRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleType",
        "identifier",
        "policy",
        "scope"
      ],
      "properties": {
        "ruleType": {
          "const": "BINARY"
        },
        "identifier": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy": {
          "enum": [
            "ALLOWLIST",
            "BLOCKLIST"
          ]
        },
        "scope": {
          "const": "global"
        }
      }
    },
    "counterfactual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "affectedBinaryCount"
      ],
      "properties": {
        "status": {
          "const": "not-performed"
        },
        "affectedBinaryCount": {
          "const": null
        }
      }
    },
    "riskFlags": {
      "const": [
        "review-required",
        "counterfactual-not-performed",
        "raw-evidence-unverified",
        "client-application-unproven"
      ]
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "azd-santa"
        },
        "version": {
          "const": "0.1.0"
        }
      }
    },
    "outputDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
